# انسخ هذا الملف إلى .env وعدّل القيم — .env لا يُرفع إلى git أبداً
# وضع التشغيل: local | cloud | hybrid
DEPLOYMENT_MODE=local

# قاعدة البيانات: SQLite (تطوير) أو PostgreSQL (إنتاج)
DATABASE_URL=sqlite:///./sijill_dev.db
# DATABASE_URL=postgresql+psycopg://sijill:STRONG_PASSWORD@db:5432/sijill_erp

# سر الجلسات: عشوائي ≥ 32 بايت — إلزامي تغييره خارج التطوير
JWT_SECRET=dev-only-insecure-secret-change-me

# الزرع الأولي (قاعدة فارغة فقط)
SEED_ON_STARTUP=true
# DEMO للعرض الداخلي، COMMERCIAL لتثبيت عميل حقيقي
BOOTSTRAP_PROFILE=DEMO
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123!Change
# رمز سري ≥ 32 حرفاً، يُسلّم لموظف شركة الأنظمة فقط
INSTALLER_TOKEN=replace-with-a-random-32-character-installer-token
